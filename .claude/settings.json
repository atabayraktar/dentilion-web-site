{
  "permissions": {
    "allow": [
      "WebFetch(domain:unsplash.com)",
      "WebFetch(domain:images.unsplash.com)",
      "WebFetch(domain:pexels.com)",
      "WebFetch(domain:images.pexels.com)"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./dist/**)",
      "Read(./package-lock.json)",
      "Read(./pnpm-lock.yaml)",
      "Read(./yarn.lock)",
      "Read(./.env*)"
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40"
  },
  "model": "sonnet",
  "effortLevel": "medium"
}
